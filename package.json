{
  "name": "shop-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @shop/api dev",
    "dev:web": "pnpm --filter @shop/web dev",
    "build": "pnpm --filter @shop/shared build && pnpm --filter @shop/api build && pnpm --filter @shop/web build",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @shop/api db:migrate",
    "db:seed": "pnpm --filter @shop/api db:seed",
    "db:reset": "pnpm --filter @shop/api db:reset",
    "db:studio": "pnpm --filter @shop/api db:studio",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
