// Retail Shop Manager — PostgreSQL schema
// Design rules:
//  1. Every business table carries shopId (multi-shop / SaaS ready).
//  2. Money is Decimal(12,2) — never Float.
//  3. Product.stockQuantity is a cached value; InventoryTransaction is the
//     append-only source of truth and can always rebuild it.
//  4. Financial records are never hard-deleted: soft-delete or VOID status.
//  5. Line items snapshot name + price so old invoices never change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  DUE
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum InventoryTxType {
  IN
  OUT
  ADJUST
}

enum InventoryRefType {
  SALE
  PURCHASE
  MANUAL
  VOID
  OPENING
}

enum ExpenseCategory {
  RENT
  UTILITY
  SALARY
  TRANSPORT
  MAINTENANCE
  MARKETING
  OTHER
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  LARGE_EXPENSE
  SALE_COMPLETED
  STOCK_ADJUSTED
  SYSTEM
}

// ---------------------------------------------------------------- tenant

model Shop {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  logoUrl   String?
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  /// Next invoice sequence number, bumped inside the sale transaction.
  invoiceSeq Int     @default(1)
  invoicePrefix String @default("INV")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  suppliers    Supplier[]
  sales        Sale[]
  purchases    Purchase[]
  expenses     Expense[]
  notifications Notification[]
  auditLogs    AuditLog[]
  inventoryTransactions InventoryTransaction[]

  @@map("shops")
}

// ---------------------------------------------------------------- identity

model User {
  id           String    @id @default(uuid())
  shopId       String
  name         String
  email        String
  phone        String?
  passwordHash String
  role         Role      @default(EMPLOYEE)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  shop                  Shop      @relation(fields: [shopId], references: [id])
  refreshTokens         RefreshToken[]
  sales                 Sale[]    @relation("SoldBy")
  voidedSales           Sale[]    @relation("VoidedBy")
  purchases             Purchase[]
  expenses              Expense[]
  inventoryTransactions InventoryTransaction[]
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@unique([email])
  @@index([shopId, role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  /// SHA-256 of the token; the raw value never touches the database.
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- catalog

model Category {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shop     Shop      @relation(fields: [shopId], references: [id])
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  shopId        String
  categoryId    String
  name          String
  sku           String
  barcode       String?
  unit          String    @default("pcs")
  costPrice     Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  /// Cached stock. Authoritative ledger = InventoryTransaction.
  stockQuantity Int       @default(0)
  minStockLevel Int       @default(5)
  imageUrl      String?
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  shop                  Shop                   @relation(fields: [shopId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  saleItems             SaleItem[]
  purchaseItems         PurchaseItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, name])
  @@index([shopId, categoryId])
  @@index([shopId, stockQuantity])
  @@map("products")
}

// ---------------------------------------------------------------- inventory ledger

model InventoryTransaction {
  id             String           @id @default(uuid())
  shopId         String
  productId      String
  type           InventoryTxType
  /// Signed: +10 for IN, -3 for OUT, either sign for ADJUST.
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  unitCost       Decimal?         @db.Decimal(12, 2)
  referenceType  InventoryRefType
  referenceId    String?
  note           String?
  createdById    String
  createdAt      DateTime         @default(now())

  shop      Shop    @relation(fields: [shopId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------- parties

model Customer {
  id                String    @id @default(uuid())
  shopId            String
  name              String
  phone             String
  address           String?
  note              String?
  /// Denormalised rollups, updated inside the sale transaction.
  totalPurchases    Decimal   @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt    DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  shop  Shop   @relation(fields: [shopId], references: [id])
  sales Sale[]

  @@unique([shopId, phone])
  @@index([shopId, name])
  @@map("customers")
}

model Supplier {
  id                String    @id @default(uuid())
  shopId            String
  name              String
  phone             String
  company           String?
  address           String?
  note              String?
  totalPurchases    Decimal   @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt    DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  shop      Shop       @relation(fields: [shopId], references: [id])
  purchases Purchase[]

  @@unique([shopId, phone])
  @@index([shopId, name])
  @@map("suppliers")
}

// ---------------------------------------------------------------- sales

model Sale {
  id             String        @id @default(uuid())
  shopId         String
  invoiceNo      String
  customerId     String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @db.Decimal(12, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(12, 2)
  /// Snapshot of profit at sale time = sum(line total - cost snapshot).
  costTotal      Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  status         SaleStatus    @default(COMPLETED)
  note           String?
  soldById       String
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shop     Shop       @relation(fields: [shopId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  soldBy   User       @relation("SoldBy", fields: [soldById], references: [id])
  voidedBy User?      @relation("VoidedBy", fields: [voidedById], references: [id])
  items    SaleItem[]

  @@unique([shopId, invoiceNo])
  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([customerId])
  @@index([soldById])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  productId      String
  /// Snapshots — the invoice must never change when the product does.
  productName    String
  sku            String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  costPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------- purchases

model Purchase {
  id          String    @id @default(uuid())
  shopId      String
  supplierId  String
  referenceNo String?
  subtotal    Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @db.Decimal(12, 2)
  dueAmount   Decimal   @default(0) @db.Decimal(12, 2)
  note        String?
  purchasedAt DateTime  @default(now())
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop      Shop           @relation(fields: [shopId], references: [id])
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([shopId, purchasedAt])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id          String  @id @default(uuid())
  purchaseId  String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitCost    Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------- expenses

model Expense {
  id          String          @id @default(uuid())
  shopId      String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime
  description String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  shop      Shop @relation(fields: [shopId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([shopId, expenseDate])
  @@index([shopId, category])
  @@map("expenses")
}

// ---------------------------------------------------------------- system

model Notification {
  id          String           @id @default(uuid())
  shopId      String
  /// null = visible to every user of the shop who has permission.
  userId      String?
  type        NotificationType
  title       String
  body        String
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  shopId    String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
