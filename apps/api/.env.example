# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://shop:shop_dev_password@localhost:5432/shop_manager?schema=public"

# --- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBER=30

# --- Seed ---------------------------------------------------------------
SEED_OWNER_EMAIL=owner@shop.test
SEED_MANAGER_EMAIL=manager@shop.test
SEED_EMPLOYEE_EMAIL=employee@shop.test
SEED_PASSWORD=Password123
